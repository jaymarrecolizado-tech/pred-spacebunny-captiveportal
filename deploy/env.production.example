# ---------------------------------------------------------------------------
# Production environment for the DICT Free Wi-Fi Customer Feedback Platform.
#
# Copy to the shared directory OUTSIDE the release tree and edit in place:
#
#   cp deploy/env.production.example /var/www/dict-feedback/shared/.env
#   php artisan key:generate --show      # paste the result into APP_KEY below
#
# Do NOT name this file `.env.production` inside the repository: the repo's
# .gitignore ignores `.env*`, so it would never be committed.
#
# This file must never be readable by the web server user's group.
#   chmod 640 shared/.env && chown deploy:www-data shared/.env
# ---------------------------------------------------------------------------

APP_NAME="DICT Free Wi-Fi Feedback"
APP_ENV=production
# Generate with: php artisan key:generate --show
APP_KEY=
# Never true in production: the debug page exposes stack traces, file paths,
# environment values and, on a bad day, credentials.
APP_DEBUG=false
# The public address of this deployment. See PORTAL_PUBLIC_URL below.
APP_URL=https://fpiapulse.dictr2.cloud

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
# `debug` would write request payloads and headers to disk.
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# --- Database --------------------------------------------------------------
# Use a dedicated, least-privilege account. Never the MariaDB root user.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dict_feedback
DB_USERNAME=dict_feedback
DB_PASSWORD=

# --- Session ---------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Keep this FALSE while the pilot is served over plain HTTP. A secure cookie is
# never sent over http://, so the session never starts, CSRF validation fails
# and the survey submission is rejected — with a confusing 419, not an error.
# Set it to true only once the deployment is HTTPS-only.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# --- Cache / queue / files ------------------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# --- Mail ------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"

# --- Captive portal handoff ------------------------------------------------
# The address a captive device can actually reach, from inside the walled
# garden. Every survey URL handed to a gateway is built from this value — NOT
# from the Host header the gateway called us on. It must be a host the
# gateway's clients can resolve BEFORE they are authenticated, which means it
# has to be on the gateway's allow-list.
#
# HTTPS is only safe here if the certificate is one the phone already trusts.
# A self-signed certificate makes the survey unreachable on iOS and Android:
# the user gets a certificate warning and never sees the survey. If no trusted
# certificate is available, use http:// and exempt the /portal/* paths from any
# HTTP -> HTTPS redirect instead.
PORTAL_PUBLIC_URL=https://fpiapulse.dictr2.cloud
PORTAL_SESSION_TTL_MINUTES=15
# Optional comma-separated allow-list of hosts a gateway may return the user to
# after the survey. Empty accepts any http(s) host; set it before the pilot
# leaves test mode.
PORTAL_ALLOWED_RETURN_HOSTS=
# Must stay false. The simulator can mint survey sessions and is a development
# tool only.
PORTAL_SIMULATOR_ENABLED=false

# --- Pilot gateway (TP-Link Omada) ----------------------------------------
# Real credentials belong here, never in the repository, a migration or a seed.
OMADA_CONTROLLER_URL=
OMADA_OMADA_ID=
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=
