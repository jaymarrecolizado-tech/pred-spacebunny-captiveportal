APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Pilot gateway: TP-Link Omada controller. Copy real values into your local .env
# only — never commit them. Used by the Phase 5 captive portal adapter.
OMADA_CONTROLLER_URL=
OMADA_OMADA_ID=
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=

# Captive portal handoff.
# The host a captive device can actually reach, over plain HTTP. Every survey
# URL is built from this, never from the Host header the gateway used.
PORTAL_PUBLIC_URL="${APP_URL}"
PORTAL_SESSION_TTL_MINUTES=15
# Optional comma-separated allow-list of hosts the gateway may return the user
# to. Empty = any http(s) host.
PORTAL_ALLOWED_RETURN_HOSTS=
# The gateway simulator must never be enabled outside local development.
PORTAL_SIMULATOR_ENABLED=false
# Authorization duration granted after a survey, in MILLISECONDS (default 1h).
# Microseconds overflow the controller's 32-bit field: the grant is created but
# is already expired, and the client never gets internet.
PORTAL_AUTH_DURATION_MS=
# Omada authorize-back (TP-Link doc 13080): hotspot operator account from the
# controller's hotspot manager + the controller ID from its URL. Empty until
# the pilot reaches step 5; the adapter degrades gracefully without them.
OMADA_CONTROLLER_ID=
OMADA_HOTSPOT_OPERATOR=
OMADA_HOTSPOT_PASSWORD=
# Where the portal thanks page sends an authorized user after the countdown.
# Admin-configured only — never taken from the user-editable redirectUrl.
PORTAL_SUCCESS_URL=
